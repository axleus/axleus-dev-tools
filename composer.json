{
    "name": "webware/traccio",
    "description": "Tracy Debugger integration and profiler for Mezzio apps.",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "webware traccio"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "homepage": "https://github.com/tyrsson/traccio/discussions",
            "role": "Maintainer"
        }
    ],
    "suggest": {
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "tracy/tracy": "^2.11.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.92.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.5.4",
        "roave/security-advisories": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Webware\\Traccio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareIntegrationTest\\Traccio\\": "test/integration/",
            "WebwareTestAsset\\Traccio\\": "test/asset/",
            "WebwareTest\\Traccio\\": "test/unit/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "cs-check": "vendor/bin/php-cs-fixer check",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "sa": "vendor/bin/phpstan analyse --memory-limit=256M",
        "sa-baseline": "vendor/bin/phpstan analyse --memory-limit=256M --generate-baseline"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        },
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "composer/package-versions-deprecated": true
        }
    }
}
