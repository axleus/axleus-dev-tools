{
    "name": "webware/dev-tools",
    "description": "Tracy Debugger integration for Mezzio apps.",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "webware dev tools"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "homepage": "https://github.com/tyrsson/dev-tools/discussions",
            "role": "Maintainer"
        }
    ],
    "suggest": {
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "tracy/tracy": "^2.11.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.1",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5.42",
        "roave/security-advisories": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "Webware\\DevTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\DevToolsTest\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "sa": "vendor/bin/phpstan analyse --memory-limit=256M",
        "sa-baseline": "vendor/bin/phpstan analyse --memory-limit=256M --generate-baseline"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "laminas/laminas-component-installer": true,
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
