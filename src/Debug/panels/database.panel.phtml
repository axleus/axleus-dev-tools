<?php

declare(strict_types=1);

namespace Webware\Traccio\Debug;

use Tracy\Helpers;

// $data is the formatted array produced by ProfilerDataFormatter::format()
$summary = $data['summary'];
$groups  = $data['groups'];
?>
<h1>Query Profiles</h1>
<div class="tracy-inner tracy-QueryPanel">
    <div class="tracy-inner-container">
        <table class="tracy-QueryPanel-summary">
            <thead>
                <tr>
                    <th>Total queries</th>
                    <th>Unique statements</th>
                    <th>Total elapsed</th>
                    <th>Slowest single</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><?= $summary['total_queries'] ?></td>
                    <td><?= $summary['unique_statements'] ?></td>
                    <td><?= sprintf('%.3f ms', $summary['total_elapsed'] * 1000) ?></td>
                    <td><?= sprintf('%.3f ms', $summary['slowest_elapsed'] * 1000) ?></td>
                </tr>
            </tbody>
        </table>

        <?php if ($groups === []): ?>
            <p><em>No queries recorded.</em></p>
        <?php else: ?>
            <?php foreach ($groups as $group): ?>
                <div class="tracy-QueryPanel-group">
                    <div class="tracy-QueryPanel-group-header">
                        <span class="tracy-QueryPanel-badge"><?= $group['count'] ?>&times;</span>
                        <span class="tracy-QueryPanel-sql"><?= Helpers::escapeHtml($group['sql']) ?></span>
                        <span class="tracy-QueryPanel-group-time">
                            <?= sprintf('%.3f ms', $group['total_elapsed'] * 1000) ?> total
                            &bull;
                            avg <?= sprintf('%.3f ms', $group['avg_elapsed'] * 1000) ?>
                        </span>
                    </div>
                    <table class="tracy-QueryPanel-executions">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Start</th>
                                <th>Elapsed</th>
                                <th>Parameters</th>
                            </tr>
                        </thead>
                        <tbody>
                            <?php foreach ($group['executions'] as $exec): ?>
                                <tr>
                                    <td><?= $exec['index'] + 1 ?></td>
                                    <td><?= date('H:i:s', (int) $exec['start']) . sprintf('.%03d', (int)(($exec['start'] - (int) $exec['start']) * 1000)) ?></td>
                                    <td><?= sprintf('%.3f ms', $exec['elapsed'] * 1000) ?></td>
                                    <td>
                                        <?php if ($exec['parameters'] !== null && count($exec['parameters']) > 0): ?>
                                            <table class="tracy-QueryPanel-params">
                                                <tbody>
                                                    <?php foreach ($exec['parameters']->getNamedArray() as $k => $v): ?>
                                                        <?php $token = is_numeric($k) ? '?' . ((int) $k + 1) : ':' . ltrim((string) $k, ':') ?>
                                                        <tr>
                                                            <td><?= Helpers::escapeHtml($token) ?></td>
                                                            <td><?= Helpers::escapeHtml((string) $v) ?></td>
                                                        </tr>
                                                    <?php endforeach; ?>
                                                </tbody>
                                            </table>
                                        <?php else: ?>
                                            <em>none</em>
                                        <?php endif; ?>
                                    </td>
                                </tr>
                            <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            <?php endforeach; ?>
        <?php endif; ?>
    </div>
</div>